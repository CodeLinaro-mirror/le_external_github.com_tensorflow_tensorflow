+bool isVhloFp8Type(Type type) {
+  return isa<vhlo::FloatF8E3M4V1Type, vhlo::FloatF8E4M3V1Type,
+             vhlo::FloatF8E4M3FNV1Type, vhlo::FloatF8E5M2V1Type,

From 6c15aeffe3bae5df9a421cb35e041943f768c45a Mon Sep 17 00:00:00 2001
From: Ivan Evlogiev <quic_ievlogie@quicinc.com>
Date: Tue, 5 Mar 2024 09:54:08 +0000
Subject: [PATCH] Abseil: Disable ARM SIMD

Signed-off-by: Ivan Evlogiev <quic_ievlogie@quicinc.com>
---
 absl/base/config.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/absl/base/config.h b/absl/base/config.h
index ff0c2978..87403063 100644
--- a/absl/base/config.h
+++ b/absl/base/config.h
@@ -899,7 +899,7 @@ static_assert(ABSL_INTERNAL_INLINE_NAMESPACE_STR[0] != 'h' ||
 // https://llvm.org/docs/CompileCudaWithLLVM.html#detecting-clang-vs-nvcc-from-code
 #ifdef ABSL_INTERNAL_HAVE_ARM_NEON
 #error ABSL_INTERNAL_HAVE_ARM_NEON cannot be directly set
-#elif defined(__ARM_NEON) && !defined(__CUDA_ARCH__)
+#elif defined(__ARM_NEON) && !defined(__CUDA_ARCH__) && 0
 #define ABSL_INTERNAL_HAVE_ARM_NEON 1
 #endif

--
2.34.1

